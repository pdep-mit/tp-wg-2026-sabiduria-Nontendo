import wollok.game.*
import configuraciones.*
import sala.*

program NombreDeJuego {
  game.title("Nontendo | La sala de los tres sellos | Checkpoint 1")
  game.height(12)
  game.width(16)
  game.cellSize(48)
  game.boardGround("zelda/sala.png")
  sala.iniciar()
  configuracion.movimientos()
  game.start()
}