import wollok.game.*
import configuraciones.*
import sala.*

program NombreDeJuego {
  game.title("La Leyenda de Celda | Mazmorra de lava y medallon")
  game.height(12)
  game.width(16)
  game.cellSize(48)
  mazmorra.configurarAlLimpiar({ configuracion.movimientos() })
  mazmorra.reiniciarTodo()
  game.start()
}
