import wollok.game.*
import personajes.*
import combate.*
import sala.*

describe "Combate tactico" {
  test "el enemigo recorre una casilla por vez y conserva su turno mientras camina" {
    mazmorra.reiniciarTodo()
    const enemigo = new Enemigo(position = game.at(6, 2))
    combate.incorporar(enemigo)
    const inicio = io.currentTime()
    jugador.pasarTurno()
    assert.equals(game.at(6, 2), enemigo.position())
    assert.that(jugador.enEspera())
    jugador.moverArriba()
    jugador.pasarTurno()
    assert.equals(game.at(2, 2), jugador.position())
    assert.equals(enemigo, combate.participanteActual())
    io.flushEvents(inicio + 220)
    assert.equals(game.at(5, 2), enemigo.position())
    io.flushEvents(inicio + 440)
    assert.equals(game.at(4, 2), enemigo.position())
    io.flushEvents(inicio + 660)
    assert.equals(game.at(3, 2), enemigo.position())
    assert.equals(3, jugador.vida())
    io.flushEvents(inicio + 880)
    assert.equals(2, jugador.vida())
    assert.notThat(jugador.enEspera())
    assert.equals(jugador, combate.participanteActual())
  }

  test "el enemigo detecta a menos de cinco casillas e inicia el turno del jugador" {
    jugador.reiniciar()
    const enemigo = new Enemigo(position = game.at(6, 2))
    enemigo.detectarJugador()
    assert.that(jugador.enCombate())
    assert.notThat(jugador.enEspera())
    assert.that(enemigo.enEspera())
    assert.equals([jugador, enemigo], combate.participantes())
  }

  test "seleccionar habilidad y orientar ataca sin mover ni terminar turno" {
    mazmorra.reiniciarTodo()
    const enemigo = new Enemigo(position = game.at(3, 2), vida = 5)
    combate.incorporar(enemigo)
    jugador.seleccionarHabilidad(1)
    jugador.moverDerecha()
    assert.equals(game.at(2, 2), jugador.position())
    assert.equals(3, enemigo.vida())
    assert.equals(3, jugador.pasosRestantes())
    assert.notThat(jugador.ataqueDisponible())
    assert.notThat(jugador.enEspera())
    jugador.seleccionarHabilidad(1)
    jugador.moverDerecha()
    assert.equals(3, enemigo.vida())
  }

  test "derrotar al ultimo enemigo termina el combate" {
    mazmorra.reiniciarTodo()
    const enemigo = new Enemigo(position = game.at(3, 2), vida = 2)
    combate.incorporar(enemigo)
    jugador.seleccionarHabilidad(1)
    jugador.moverDerecha()
    assert.notThat(jugador.enCombate())
    assert.notThat(enemigo.enCombate())
    assert.that(combate.participantes().isEmpty())
  }

}
