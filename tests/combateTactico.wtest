import wollok.game.*
import personajes.*
import combate.*
import sala.*
import obstaculos.*
import configuraciones.*
import interfaz.*

object relojDeCombate {
  method completarTurnosEnemigos() {
    const inicio = io.currentTime()
    (1..30).forEach({ instante => io.flushEvents(inicio + instante * 100) })
  }
}

describe "Combate tactico" {
  test "el enemigo recorre una casilla por vez y conserva su turno mientras camina" {
    mazmorra.iniciarDemoAnterior()
    const enemigo = new Enemigo(position = game.at(6, 2))
    combate.incorporar(enemigo)
    const inicio = io.currentTime()
    jugador.pasarTurno()
    assert.equals(game.at(6, 2), enemigo.position())
    assert.that(jugador.enEspera())
    jugador.moverArriba()
    jugador.pasarTurno()
    assert.equals(game.at(2, 2), jugador.position())
    assert.equals(enemigo, combate.participanteActual())
    io.flushEvents(inicio + 220)
    assert.equals(game.at(5, 2), enemigo.position())
    io.flushEvents(inicio + 440)
    assert.equals(game.at(4, 2), enemigo.position())
    io.flushEvents(inicio + 660)
    assert.equals(game.at(3, 2), enemigo.position())
    assert.equals(3, jugador.vida())
    io.flushEvents(inicio + 880)
    assert.equals(2.5, jugador.vida())
    assert.notThat(jugador.enEspera())
    assert.equals(jugador, combate.participanteActual())
  }

  test "reiniciar cancela los pasos pendientes del enemigo" {
    mazmorra.iniciarDemoAnterior()
    const enemigo = new Enemigo(position = game.at(6, 2))
    combate.incorporar(enemigo)
    const inicio = io.currentTime()
    jugador.pasarTurno()
    io.flushEvents(inicio + 220)
    jugador.reiniciar()
    io.flushEvents(inicio + 440)
    io.flushEvents(inicio + 660)
    io.flushEvents(inicio + 880)
    assert.equals(game.at(5, 2), enemigo.position())
    assert.equals(3, jugador.vida())
    assert.notThat(combate.activo())
  }

  test "si el enemigo muere caminando se completa su turno sin bloquear el combate" {
    mazmorra.iniciarDemoAnterior()
    const enemigo = new Enemigo(position = game.at(6, 2))
    combate.incorporar(enemigo)
    combate.incorporar(new Enemigo(position = game.at(8, 7)))
    jugador.pasarTurno()
    enemigo.recibirDanio(3)
    relojDeCombate.completarTurnosEnemigos()
    assert.equals(jugador, combate.participanteActual())
    assert.notThat(jugador.enEspera())
    assert.equals(game.at(6, 2), enemigo.position())
  }

  test "el encuentro incorpora enemigos lejanos e inicia el turno del jugador" {
    mazmorra.iniciarDemoAnterior()
    const enemigo = new Enemigo(position = game.at(13, 7))
    enemigo.aparecer()
    combate.comenzarEncuentro()
    assert.that(jugador.enCombate())
    assert.notThat(jugador.enEspera())
    assert.that(enemigo.enEspera())
    assert.equals([jugador, enemigo], combate.participantes())
  }

  test "iniciar un encuentro vacio permite seguir explorando" {
    mazmorra.iniciarDemoAnterior()
    combate.comenzarEncuentro()
    assert.notThat(combate.activo())
    assert.notThat(jugador.enCombate())
  }

  test "moverse consume pasos pero agotarlos no termina el turno" {
    mazmorra.iniciarDemoAnterior()
    const enemigo = new Enemigo(position = game.at(8, 7))
    combate.incorporar(enemigo)
    jugador.moverDerecha()
    jugador.moverDerecha()
    jugador.moverDerecha()
    jugador.moverDerecha()
    assert.equals(game.at(5, 2), jugador.position())
    assert.equals(0, jugador.pasosRestantes())
    assert.notThat(jugador.enEspera())
  }

  test "seleccionar habilidad y orientar ataca sin mover ni terminar turno" {
    mazmorra.iniciarDemoAnterior()
    const enemigo = new Enemigo(position = game.at(3, 2), vida = 5)
    combate.incorporar(enemigo)
    jugador.seleccionarHabilidad(1)
    jugador.moverDerecha()
    assert.equals(game.at(2, 2), jugador.position())
    assert.equals(3, enemigo.vida())
    assert.equals(3, jugador.pasosRestantes())
    assert.notThat(jugador.ataqueDisponible())
    assert.notThat(jugador.enEspera())
    jugador.seleccionarHabilidad(1)
    jugador.moverDerecha()
    assert.equals(3, enemigo.vida())
  }

  test "pasar ejecuta los enemigos en orden y recupera los recursos del jugador" {
    mazmorra.iniciarDemoAnterior()
    const primero = new Enemigo(position = game.at(3, 2))
    const segundo = new Enemigo(position = game.at(2, 3))
    combate.incorporar(primero)
    combate.incorporar(segundo)
    jugador.pasarTurno()
    relojDeCombate.completarTurnosEnemigos()
    assert.equals(2, jugador.vida())
    assert.equals(jugador, combate.participanteActual())
    assert.notThat(jugador.enEspera())
    assert.that(primero.enEspera())
    assert.that(segundo.enEspera())
    assert.equals(3, jugador.pasosRestantes())
    assert.that(jugador.ataqueDisponible())
  }

  test "el enemigo se acerca y golpea solo al quedar adyacente" {
    mazmorra.iniciarDemoAnterior()
    const enemigo = new Enemigo(position = game.at(6, 2))
    combate.incorporar(enemigo)
    jugador.pasarTurno()
    relojDeCombate.completarTurnosEnemigos()
    assert.equals(game.at(3, 2), enemigo.position())
    assert.equals(2.5, jugador.vida())
  }

  test "un nuevo enemigo no reinicia los pasos ni duplica participantes" {
    mazmorra.iniciarDemoAnterior()
    const primero = new Enemigo(position = game.at(3, 2))
    combate.incorporar(primero)
    jugador.moverArriba()
    const segundo = new Enemigo(position = game.at(2, 4))
    combate.incorporar(segundo)
    combate.incorporar(segundo)
    assert.equals(2, jugador.pasosRestantes())
    assert.equals(3, combate.participantes().size())
    assert.that(segundo.enEspera())
  }

  test "derrotar al ultimo enemigo termina el combate" {
    mazmorra.iniciarDemoAnterior()
    const enemigo = new Enemigo(position = game.at(3, 2), vida = 2)
    combate.incorporar(enemigo)
    jugador.seleccionarHabilidad(1)
    jugador.moverDerecha()
    assert.notThat(jugador.enCombate())
    assert.notThat(enemigo.enCombate())
    assert.that(combate.participantes().isEmpty())
  }

  test "reiniciar limpia el encuentro y los estados" {
    mazmorra.iniciarDemoAnterior()
    const enemigo = new Enemigo(position = game.at(3, 2))
    combate.incorporar(enemigo)
    mazmorra.iniciarDemoAnterior()
    assert.notThat(jugador.enCombate())
    assert.notThat(enemigo.enCombate())
    assert.that(combate.participantes().isEmpty())
    assert.equals(2, jugador.habilidades().size())
  }

  test "el disparo alcanza tres casillas y respeta las paredes" {
    mazmorra.iniciarDemoAnterior()
    const enemigo = new Enemigo(position = game.at(5, 2))
    combate.incorporar(enemigo)
    jugador.seleccionarHabilidad(2)
    jugador.moverDerecha()
    assert.equals(2, enemigo.vida())
    assert.equals(game.at(2, 2), jugador.position())
    jugador.position(game.at(9, 2))
    enemigo.position(game.at(11, 2))
    jugador.iniciarTurno()
    jugador.seleccionarHabilidad(2)
    jugador.moverDerecha()
    assert.equals(2, enemigo.vida())
    assert.that(jugador.ataqueDisponible())
  }

  test "el enemigo rodea el muro en vez de atravesarlo" {
    mazmorra.iniciarDemoAnterior()
    barrera.abierta(true)
    jugador.position(game.at(9, 3))
    const enemigo = new Enemigo(position = game.at(11, 3))
    combate.incorporar(enemigo)
    jugador.pasarTurno()
    relojDeCombate.completarTurnosEnemigos()
    assert.equals(game.at(9, 4), enemigo.position())
    assert.equals(2.5, jugador.vida())
  }

  test "un movimiento bloqueado no gasta pasos" {
    mazmorra.iniciarDemoAnterior()
    jugador.position(game.at(9, 2))
    combate.incorporar(new Enemigo(position = game.at(12, 7)))
    jugador.moverDerecha()
    assert.equals(game.at(9, 2), jugador.position())
    assert.equals(3, jugador.pasosRestantes())
  }

  test "un enemigo sin camino no se mueve ni ataca" {
    mazmorra.iniciarDemoAnterior()
    jugador.position(game.at(9, 3))
    const enemigo = new Enemigo(position = game.at(11, 3))
    combate.incorporar(enemigo)
    jugador.pasarTurno()
    relojDeCombate.completarTurnosEnemigos()
    assert.equals(game.at(11, 3), enemigo.position())
    assert.equals(3, jugador.vida())
  }

  test "los muertos se saltean y los vivos conservan su lugar" {
    mazmorra.iniciarDemoAnterior()
    const primero = new Enemigo(position = game.at(3, 2), vida = 2)
    const segundo = new Enemigo(position = game.at(2, 3))
    combate.incorporar(primero)
    combate.incorporar(segundo)
    jugador.seleccionarHabilidad(1)
    jugador.moverDerecha()
    jugador.pasarTurno()
    relojDeCombate.completarTurnosEnemigos()
    assert.equals(2.5, jugador.vida())
    assert.equals(jugador, combate.participanteActual())
  }

  test "morir durante el turno enemigo termina el combate" {
    mazmorra.iniciarDemoAnterior()
    jugador.vida(1)
    combate.incorporar(new Enemigo(position = game.at(3, 2)))
    combate.incorporar(new Enemigo(position = game.at(2, 3)))
    jugador.pasarTurno()
    relojDeCombate.completarTurnosEnemigos()
    assert.equals(0, jugador.vida())
    assert.notThat(sala.enCurso())
    assert.notThat(jugador.enCombate())
    assert.that(combate.participantes().isEmpty())
  }

  test "al restaurar la luz aparecen tres enemigos registrados" {
    mazmorra.iniciarDemoAnterior()
    mazmorra.avanzar()
    sala.presionarCable("1")
    sala.presionarCable("D")
    sala.presionarCable("2")
    sala.presionarCable("A")
    sala.presionarCable("3")
    sala.presionarCable("F")
    sala.presionarCable("4")
    sala.presionarCable("S")
    assert.equals(3, combate.enemigosVivos().size())
    combate.enemigosVivos().forEach({ enemigo => assert.that(game.hasVisual(enemigo)) })
    jugador.position(game.at(9, 4))
    assert.equals(4, combate.participantes().size())
    assert.that(jugador.enCombate())
  }

  test "los controles numericos seleccionan las habilidades durante el combate" {
    mazmorra.iniciarDemoAnterior()
    combate.incorporar(new Enemigo(position = game.at(3, 2)))
    configuracion.habilidadOCable(2)
    assert.equals(jugador.habilidades().get(1), jugador.habilidadSeleccionada())
    configuracion.habilidadOCable(1)
    assert.equals(jugador.habilidades().get(0), jugador.habilidadSeleccionada())
    assert.that(vistaCombate.text().contains("TU TURNO"))
    assert.that(vistaCombate.text().contains("Pasos: 3"))
    assert.equals("seleccionado", interfaz.acciones().first().estado())
    assert.equals("supernivel/accion-1-seleccionado.png", interfaz.acciones().first().image())
  }

  test "durante el combate las cajas bloquean el movimiento sin activar el puzzle" {
    mazmorra.iniciarDemoAnterior()
    mazmorra.avanzar()
    sala.actual().revelarResto()
    jugador.position(game.at(4, 3))
    combate.incorporar(combate.enemigosVivos().first())
    jugador.moverDerecha()
    assert.equals(game.at(4, 3), jugador.position())
    assert.that(sala.actual().hayCajaEn(game.at(5, 3)))
    assert.equals(3, jugador.pasosRestantes())
  }

  test "explorando no se puede empujar una caja sobre un enemigo" {
    mazmorra.iniciarDemoAnterior()
    mazmorra.avanzar()
    sala.actual().revelarResto()
    combate.enemigosVivos().first().position(game.at(6, 3))
    jugador.position(game.at(4, 3))
    jugador.moverDerecha()
    assert.equals(game.at(4, 3), jugador.position())
    assert.that(sala.actual().hayCajaEn(game.at(5, 3)))
    assert.notThat(sala.actual().hayCajaEn(game.at(6, 3)))
  }
}
