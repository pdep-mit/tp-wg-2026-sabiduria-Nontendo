import wollok.game.*
import sala.*
import personajes.*
import interfaz.*
import combate.*
import tests.soporteRecorrido.*

describe "Interfaz y apariciones" {
  test "los corazones representan salud completa parcial y vacia durante combate" {
    mazmorra.reiniciarTodo()
    assert.equals(3, interfaz.corazones().size())
    jugador.vida(1.5)
    assert.equals(["supernivel/corazon-4.png", "supernivel/corazon-2.png", "supernivel/corazon-0.png"], interfaz.corazones().map({ corazon => corazon.image() }))
    jugador.vida(2.75)
    assert.equals("supernivel/corazon-3.png", interfaz.corazones().last().image())
    combate.incorporar(new Enemigo(position = game.at(7, 2)))
    assert.that(interfaz.corazones().all({ corazon => game.hasVisual(corazon) }))
    assert.notThat(vistaCombate.text().contains("Vida:"))
  }

  test "el inventario dibuja los sprites y consume cada llave en su propia cerradura" {
    mazmorra.reiniciarTodo()
    mazmorra.habitacion("0-1").llave().interactuar(jugador)
    mazmorra.habitacion("2-0").llave().interactuar(jugador)
    assert.equals("zelda/llave.png", interfaz.iconos().first().image())
    mazmorra.irA("1-1", game.at(7, 6))
    const pasillo = sala.actual()
    pasillo.cofre().interactuar(jugador)
    assert.notThat(jugador.tiene("llave 1"))
    assert.that(jugador.tiene("llave 2"))
    assert.that(jugador.tiene("armadura lava"))
    const puerta = pasillo.puertas().last()
    puerta.image()
    assert.that(jugador.tiene("llave 2"))
    puerta.interactuar(jugador)
    assert.notThat(jugador.tiene("llave 2"))
    assert.equals("supernivel/armadura.png", interfaz.iconos().first().image())
    assert.equals("zelda/transparente.png", interfaz.iconos().get(1).image())
    mazmorra.irA("1-1", game.at(14, 4))
    assert.that(puerta.abierta())
    puerta.interactuar(jugador)
    assert.equals("2-1", sala.actual().identificador())
    assert.equals(1, jugador.objetosInventario().size())
  }

  test "la luz vuelve antes del humo y cada slime se materializa sobre su charco" {
    mazmorra.reiniciarTodo()
    mazmorra.irA("0-1", game.at(14, 4))
    const oscura = sala.actual()
    oscura.encenderLuz()
    const inicio = io.currentTime()
    assert.that(oscura.luzEncendida())
    assert.that(combate.enemigosVivos().isEmpty())
    assert.equals(jugador, game.allVisuals().filter({ visual => !interfaz.elementos().contains(visual) }).last())
    io.flushEvents(inicio + 600)
    assert.notThat(oscura.humos().any({ humo => game.hasVisual(humo) }))
    io.flushEvents(inicio + 700)
    assert.that(oscura.humos().all({ humo => game.hasVisual(humo) }))
    assert.that(combate.enemigosVivos().isEmpty())
    io.flushEvents(inicio + 1100)
    assert.notThat(jugador.enCombate())
    assert.equals([game.at(3, 3), game.at(5, 6), game.at(10, 5), game.at(12, 2)], oscura.slimes().map({ slime => slime.position() }))
    assert.equals(4, combate.enemigosVivos().size())
    assert.equals(jugador, game.allVisuals().filter({ visual => !interfaz.elementos().contains(visual) }).last())
    io.flushEvents(inicio + 1650)
    assert.that(jugador.enCombate())
    assert.notThat(oscura.movimientoBloqueado())
    assert.notThat(oscura.humos().any({ humo => game.hasVisual(humo) }))
    oscura.encenderLuz()
    assert.equals(4, combate.enemigosVivos().size())
  }

  test "reiniciar durante el humo cancela la aparicion anterior" {
    mazmorra.reiniciarTodo()
    mazmorra.irA("0-1", game.at(14, 4))
    const oscura = sala.actual()
    oscura.encenderLuz()
    const inicio = io.currentTime()
    io.flushEvents(inicio + 700)
    assert.that(oscura.humos().all({ humo => game.hasVisual(humo) }))
    mazmorra.reiniciarTodo()
    io.flushEvents(inicio + 3000)
    assert.equals("1-0", sala.actual().identificador())
    assert.that(combate.enemigosVivos().isEmpty())
    assert.notThat(oscura.humos().any({ humo => game.hasVisual(humo) }))
  }

  test "la aparicion se retoma una sola vez si se recarga la sala antes del spawn" {
    mazmorra.reiniciarTodo()
    mazmorra.irA("0-1", game.at(14, 4))
    const oscura = sala.actual()
    oscura.encenderLuz()
    mazmorra.irA("1-1", game.at(1, 4))
    mazmorra.irA("0-1", game.at(14, 4))
    recorrido.terminarAparicion()
    assert.equals(4, combate.enemigosVivos().size())
    assert.that(oscura.enemigosGenerados())
    assert.notThat(oscura.aparicionEnCurso())
  }

  test "el boton de salida usa el mismo sprite que los sellos y permanece debajo de Link" {
    mazmorra.reiniciarTodo()
    mazmorra.irA("0-1", game.at(14, 4))
    sala.actual().encenderLuz()
    recorrido.terminarAparicion()
    combate.enemigosVivos().forEach({ enemigo => enemigo.recibirDanio(2) })
    combate.verificarFinal()
    assert.equals("supernivel/boton-A.png", sala.actual().acciones().last().image())
    assert.equals(jugador, game.allVisuals().filter({ visual => !interfaz.elementos().contains(visual) }).last())
    jugador.position(game.at(2, 2))
    sala.interactuar()
    assert.equals("supernivel/boton-A-on.png", sala.actual().acciones().last().image())
    assert.equals(jugador, game.allVisuals().filter({ visual => !interfaz.elementos().contains(visual) }).last())
  }

  test "el guardian izquierdo es mas fuerte y los tres slimes completan sus turnos" {
    mazmorra.reiniciarTodo()
    mazmorra.irA("2-2", game.at(14, 5))
    const final = sala.actual()
    assert.equals(4, combate.participantes().size())
    assert.that(final.guardianes().all({ slime => slime.enCombate() }))
    assert.that(final.guardianes().take(2).all({ slime => slime.sprite() == "zelda/enemigo.png" and slime.vida() == 2 and slime.habilidad().danio() == 0.5 }))
    const guardian = final.guardianes().last()
    assert.equals(4, guardian.vida())
    assert.equals(5, guardian.pasosPorTurno())
    assert.equals(1, guardian.habilidad().danio())
    assert.equals(160, guardian.milisegundosPorPaso())
    assert.equals("supernivel/slime-guardian.png", guardian.image())
    recorrido.pasarTurno()
    assert.equals(game.at(9, 5), guardian.position())
    assert.equals(jugador, combate.participanteActual())
    assert.notThat(jugador.enEspera())
    final.guardianes().first().recibirDanio(2)
    recorrido.pasarTurno()
    assert.equals(jugador, combate.participanteActual())
    final.guardianes().get(1).recibirDanio(2)
    final.guardianes().get(2).recibirDanio(4)
    combate.verificarFinal()
    assert.notThat(jugador.enCombate())
    assert.equals("MEDALLON_DISPONIBLE", final.estadoFinal())
  }

  test "equipar la armadura cambia las cuatro direcciones de Link y reiniciar recupera el verde" {
    mazmorra.reiniciarTodo()
    mazmorra.habitacion("0-1").llave().interactuar(jugador)
    mazmorra.irA("1-1", game.at(7, 6))
    sala.actual().cofre().interactuar(jugador)
    jugador.moverAbajo()
    assert.equals("supernivel/link-rojo-abajo.png", jugador.image())
    jugador.moverDerecha()
    assert.equals("supernivel/link-rojo-derecha.png", jugador.image())
    jugador.moverArriba()
    assert.equals("supernivel/link-rojo-arriba.png", jugador.image())
    jugador.moverIzquierda()
    assert.equals("supernivel/link-rojo-izquierda.png", jugador.image())
    jugador.recibirDanio(0.5)
    const inicio = io.currentTime()
    io.flushEvents(inicio + 150)
    assert.equals("zelda/transparente.png", jugador.image())
    io.flushEvents(inicio + 550)
    assert.equals("supernivel/link-rojo-izquierda.png", jugador.image())
    mazmorra.irA("1-0", game.at(7, 8))
    assert.equals("supernivel/link-rojo-izquierda.png", jugador.image())
    mazmorra.reiniciarTodo()
    assert.equals("zelda/link-abajo.png", jugador.image())
    assert.equals(3, jugador.vida())
  }

  test "la victoria ocupa todo el tablero sin escena ni HUD y permite reiniciar" {
    mazmorra.reiniciarTodo()
    mazmorra.irA("2-2", game.at(14, 5))
    const final = sala.actual()
    final.guardianes().forEach({ enemigo => enemigo.recibirDanio(10) })
    combate.verificarFinal()
    final.medallon().interactuar(jugador)
    assert.equals("VICTORIA", final.estadoFinal())
    assert.equals("supernivel/victoria.png", game.boardGround())
    assert.that(game.allVisuals().isEmpty())
    assert.notThat(sala.enCurso())
    const posicion = jugador.position()
    jugador.moverIzquierda()
    assert.equals(posicion, jugador.position())
    mazmorra.reiniciarTodo()
    assert.equals("supernivel/sala-1-0.png", game.boardGround())
    assert.that(game.hasVisual(jugador))
    assert.that(sala.enCurso())
  }

  test "reentrar a una sala con slimes vivos inicia todos los turnos sin acercarse" {
    mazmorra.reiniciarTodo()
    mazmorra.irA("0-1", game.at(14, 4))
    sala.actual().encenderLuz()
    recorrido.terminarAparicion()
    assert.that(jugador.enCombate())
    // Simula una recarga de escena; el jugador no puede huir en pleno combate.
    combate.finalizar()
    mazmorra.irA("1-1", game.at(1, 4))
    mazmorra.irA("0-1", game.at(14, 4))
    assert.equals(5, combate.participantes().size())
    assert.that(jugador.enCombate())
    assert.notThat(jugador.enEspera())
    assert.that(combate.enemigosVivos().all({ enemigo => enemigo.enCombate() and combate.distancia(enemigo.position(), jugador.position()) > 1 }))
    jugador.moverIzquierda()
    combate.comenzarEncuentro()
    assert.equals(2, jugador.pasosRestantes())
    assert.equals(5, combate.participantes().size())
  }

  test "las piedras se bloquean entre si y la puerta requiere despejar el paso" {
    mazmorra.reiniciarTodo()
    mazmorra.irA("3-1", game.at(1, 4))
    const cantera = sala.actual()
    const caminoInicial = recorrido.buscar([[jugador.position()]], [jugador.position()], game.at(7, 8))
    assert.that(caminoInicial.isEmpty())
    assert.notThat(cantera.cajas().intentarEmpujar(game.at(7, 3), game.at(8, 3), { posicion => sala.permitePasar(posicion) }))
    assert.that(cantera.hayCajaEn(game.at(7, 3)))
    assert.that(cantera.hayCajaEn(game.at(8, 3)))
    assert.that(cantera.puertas().last().abierta())
    recorrido.resolverCantera()
    assert.that(cantera.resuelto())
    sala.interactuar()
    assert.equals("pasaje", sala.actual().identificador())
  }
}
