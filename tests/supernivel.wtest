import wollok.game.*
import sala.*
import personajes.*
import objetos.*
import combate.*

import tests.soporteRecorrido.*

describe "Supernivel conectado" {
  test "todos los visuales de las salas tienen un sprite valido aun con botones resueltos" {
    mazmorra.reiniciarTodo()
    ["1-0", "1-1", "0-1", "2-0", "2-1", "3-1", "pasaje", "2-2"].forEach({ id =>
      mazmorra.habitacion(id).elementosDeEscena().forEach({ visual => assert.that(visual.image().endsWith(".png")) })
    })
    const secuencia = mazmorra.habitacion("2-1").secuencia()
    ["B", "A", "C"].forEach({ letra => secuencia.presionar(letra) })
    assert.that(secuencia.resuelto())
    mazmorra.habitacion("2-1").acciones().forEach({ boton => assert.that(boton.image().endsWith("-on.png")) })
  }

  test "recorrido completo desde el puente hasta ganar con controles y combate reales" {
    mazmorra.reiniciarTodo()
    assert.equals("1-0", sala.actual().identificador())
    assert.equals(game.at(7, 1), jugador.position())
    recorrido.caminarA(10, 6)
    (1..5).forEach({ paso => jugador.moverIzquierda() })
    assert.that(mazmorra.habitacion("1-0").resuelto())
    recorrido.usarEn(7, 8)
    assert.equals("1-1", sala.actual().identificador())
    recorrido.usarEn(1, 4)
    assert.equals("0-1", sala.actual().identificador())
    recorrido.usarEn(7, 7)
    assert.that(sala.actual().movimientoBloqueado())
    recorrido.conectarCables()
    recorrido.terminarAparicion()
    assert.equals(4, combate.enemigosVivos().size())
    assert.that(jugador.enCombate())
    recorrido.ganarCombateOscuro()
    recorrido.usarEn(7, 4)
    assert.that(jugador.tiene("llave 1"))
    recorrido.usarEn(2, 2)
    recorrido.usarEn(14, 4)
    recorrido.usarEn(7, 6)
    assert.that(jugador.tiene("armadura lava"))
    recorrido.usarEn(7, 1)
    recorrido.usarEn(14, 4)
    assert.equals("2-0", sala.actual().identificador())
    recorrido.usarEn(6, 5)
    recorrido.usarEn(9, 5)
    assert.that(jugador.tiene("arco"))
    assert.that(jugador.tiene("llave 2"))
    recorrido.usarEn(1, 4)
    recorrido.usarEn(7, 8)
    recorrido.usarEn(14, 4)
    assert.equals("2-1", sala.actual().identificador())
    recorrido.usarEn(4, 5)
    assert.equals(0, sala.actual().secuencia().progreso())
    recorrido.usarEn(7, 5)
    recorrido.usarEn(4, 5)
    recorrido.usarEn(10, 5)
    assert.that(sala.actual().secuencia().resuelto())
    recorrido.usarEn(14, 4)
    assert.equals("3-1", sala.actual().identificador())
    recorrido.resolverCantera()
    assert.that(sala.actual().resuelto())
    recorrido.usarEn(7, 8)
    assert.equals("pasaje", sala.actual().identificador())
    recorrido.usarEn(1, 5)
    assert.equals("2-2", sala.actual().identificador())
    assert.equals("COMBATE", sala.actual().estadoFinal())
    assert.notThat(game.hasVisual(sala.actual().medallon()))
    assert.equals(3, combate.enemigosVivos().size())

    recorrido.ganarCombateFinal()
    assert.notThat(jugador.enCombate())
    assert.equals("MEDALLON_DISPONIBLE", sala.actual().estadoFinal())
    assert.that(game.hasVisual(sala.actual().medallon()))
    recorrido.usarEn(7, 5)
    assert.that(jugador.tiene("medallon"))
    assert.equals("VICTORIA", sala.actual().estadoFinal())
    assert.notThat(sala.enCurso())
  }

  test "la lava y su puerta impiden conseguir el arco sin armadura" {
    mazmorra.reiniciarTodo()
    assert.notThat(sala.permitePasar(game.at(8, 2)))
    assert.notThat(sala.permitePasar(game.at(14, 4)))
    const puerta = sala.actual().puertas().last()
    puerta.interactuar(jugador)
    assert.equals("1-0", sala.actual().identificador())
    jugador.guardar(new ObjetoRecogible(nombre = "armadura lava", sprite = "supernivel/armadura.png", position = game.at(1, 1)))
    assert.that(sala.permitePasar(game.at(14, 4)))
    assert.that(puerta.abierta())
  }

  test "cambiar de sala conserva vida y restaura el sprite si se cancelo un parpadeo" {
    mazmorra.reiniciarTodo()
    jugador.recibirDanio(1)
    io.flushEvents(io.currentTime() + 120)
    assert.equals("zelda/transparente.png", jugador.image())
    mazmorra.irA("1-1", game.at(7, 1))
    assert.equals("zelda/link-abajo.png", jugador.image())
    assert.equals(2, jugador.vida())
  }

  test "cofre y puerta del pasillo validan llaves distintas y no duplican la armadura" {
    mazmorra.reiniciarTodo()
    mazmorra.irA("1-1", game.at(7, 6))
    const pasillo = sala.actual()
    pasillo.cofre().interactuar(jugador)
    assert.notThat(pasillo.cofre().abierto())
    jugador.guardar(mazmorra.habitacion("2-0").llave())
    pasillo.cofre().interactuar(jugador)
    assert.notThat(pasillo.cofre().abierto())
    jugador.guardar(mazmorra.habitacion("0-1").llave())
    pasillo.cofre().interactuar(jugador)
    const inventario = jugador.inventarioTexto()
    pasillo.cofre().interactuar(jugador)
    assert.equals(inventario, jugador.inventarioTexto())
    mazmorra.irA("1-0", game.at(7, 8))
    mazmorra.irA("1-1", game.at(7, 1))
    assert.equals(pasillo, sala.actual())
    assert.that(pasillo.cofre().abierto())
  }

  test "la oscuridad revela una unica llave y cuatro enemigos persistentes" {
    mazmorra.reiniciarTodo()
    mazmorra.irA("0-1", game.at(14, 4))
    const oscura = sala.actual()
    assert.that(combate.enemigosVivos().isEmpty())
    assert.notThat(oscura.puertas().first().abierta())
    assert.notThat(game.hasVisual(oscura.llave()))
    recorrido.conectarCables()
    assert.notThat(oscura.luzEncendida())
    oscura.encenderLuz()
    oscura.encenderLuz()
    assert.that(combate.enemigosVivos().isEmpty())
    recorrido.terminarAparicion()
    assert.equals(4, combate.enemigosVivos().size())
    const primero = combate.enemigosVivos().first()
    primero.recibirDanio(2)
    mazmorra.irA("1-1", game.at(1, 4))
    assert.equals(oscura, sala.actual())
    combate.enemigosVivos().forEach({ enemigo => enemigo.recibirDanio(2) })
    combate.verificarFinal()
    oscura.llave().interactuar(jugador)
    mazmorra.irA("1-1", game.at(1, 4))
    assert.that(combate.enemigosVivos().isEmpty())
    mazmorra.irA("0-1", game.at(14, 4))
    assert.that(combate.enemigosVivos().isEmpty())
    assert.notThat(game.hasVisual(primero))
    assert.notThat(game.hasVisual(oscura.llave()))
    assert.that(oscura.luzEncendida())
  }

  test "B A C persiste y un error parcial reinicia la secuencia" {
    mazmorra.reiniciarTodo()
    mazmorra.irA("2-1", game.at(1, 4))
    const botones = sala.actual()
    botones.secuencia().presionar("B")
    botones.secuencia().presionar("C")
    assert.equals(0, botones.secuencia().progreso())
    assert.notThat(botones.puertas().last().abierta())
    ["B", "A", "C"].forEach({ letra => botones.secuencia().presionar(letra) })
    mazmorra.irA("1-1", game.at(14, 4))
    mazmorra.irA("2-1", game.at(1, 4))
    assert.that(botones.puertas().last().abierta())
  }

  test "reponer cajas no reinicia inventario ni deja cajas sobre el jugador" {
    mazmorra.reiniciarTodo()
    mazmorra.irA("3-1", game.at(7, 4))
    mazmorra.reiniciarCajas()
    assert.notThat(sala.actual().hayCajaEn(jugador.position()))
    assert.that(sala.actual().hayCajaEn(game.at(6, 3)))
    assert.that(sala.actual().hayCajaEn(game.at(7, 3)))
    assert.equals(game.at(1, 4), jugador.position())
    mazmorra.irA("1-0", game.at(9, 6))
    mazmorra.reiniciarCajas()
    assert.notThat(sala.actual().hayCajaEn(jugador.position()))
  }

  test "el medallon solo aparece tras el ultimo guardian y una muerte no se cuenta dos veces" {
    mazmorra.reiniciarTodo()
    mazmorra.irA("2-2", game.at(14, 5))
    const final = sala.actual()
    final.medallon().interactuar(jugador)
    assert.notThat(jugador.tiene("medallon"))
    final.guardianes().get(0).recibirDanio(10)
    final.guardianes().get(0).recibirDanio(10)
    final.guardianes().get(1).recibirDanio(10)
    new Enemigo(position = game.at(2, 2)).recibirDanio(10)
    assert.equals("COMBATE", final.estadoFinal())
    assert.notThat(game.hasVisual(final.medallon()))
    final.guardianes().get(2).recibirDanio(10)
    combate.verificarFinal()
    assert.equals("MEDALLON_DISPONIBLE", final.estadoFinal())
    final.guardianes().get(2).recibirDanio(10)
    mazmorra.irA("pasaje", game.at(1, 5))
    mazmorra.irA("2-2", game.at(14, 5))
    assert.that(game.hasVisual(final.medallon()))
    assert.that(combate.enemigosVivos().isEmpty())
    final.medallon().interactuar(jugador)
    const inventario = jugador.inventarioTexto()
    final.medallon().interactuar(jugador)
    assert.equals(inventario, jugador.inventarioTexto())
    assert.equals("VICTORIA", final.estadoFinal())
  }

  test "morir durante el final y reiniciar restablece enemigos y oculta el premio" {
    mazmorra.reiniciarTodo()
    mazmorra.irA("2-2", game.at(14, 5))
    sala.actual().guardianes().first().recibirDanio(10)
    jugador.recibirDanio(3)
    assert.notThat(sala.enCurso())
    mazmorra.reiniciarTodo()
    assert.equals("1-0", sala.actual().identificador())
    assert.notThat(jugador.tiene("arco"))
    mazmorra.irA("2-2", game.at(14, 5))
    assert.equals(3, combate.enemigosVivos().size())
    assert.equals("COMBATE", sala.actual().estadoFinal())
    assert.notThat(game.hasVisual(sala.actual().medallon()))
  }
}
