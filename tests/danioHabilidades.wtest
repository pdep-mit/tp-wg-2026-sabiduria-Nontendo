import wollok.game.*
import personajes.*
import habilidades.*
import combate.*
import sala.*

class GolpeSinDanio inherits Fisico {
  override method daniar(objetivo) {}
}

describe "La habilidad aplica el dano" {
  test "la habilidad envia su dano al objetivo" {
    mazmorra.iniciarDemoAnterior()
    new Fisico().daniar(jugador)
    assert.equals(1, jugador.vida())
  }

  test "el enemigo delega el dano a su habilidad" {
    mazmorra.iniciarDemoAnterior()
    const enemigo = new Enemigo(position = game.at(3, 2), habilidad = new GolpeSinDanio())
    combate.incorporar(enemigo)
    jugador.pasarTurno()
    io.flushEvents(io.currentTime() + 220)
    assert.equals(3, jugador.vida())
    assert.equals(jugador, combate.participanteActual())
  }

  test "ejecutar un ataque tambien delega a daniar" {
    mazmorra.iniciarDemoAnterior()
    const enemigo = new Enemigo(position = game.at(3, 2))
    assert.that(new GolpeSinDanio().ejecutar(jugador, "derecha", [enemigo]))
    assert.equals(3, enemigo.vida())
  }
}
